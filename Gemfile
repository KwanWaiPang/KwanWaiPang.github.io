source "https://rubygems.org"

# This site is hosted on GitHub Pages. The `github-pages` gem bundles Jekyll
# and all supported plugins (jekyll-sitemap, jekyll-feed, jekyll-paginate, ...)
# pinned to the exact versions GitHub Pages uses in production.
gem "github-pages", group: :jekyll_plugins

# Ruby 3.0+ no longer ships these as default gems but Jekyll needs them.
gem "webrick"
gem "csv"
gem "logger"
gem "base64"
gem "bigdecimal"
